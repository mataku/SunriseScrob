{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Asia/Tokyo',
  schedule: [
    'after 3pm on Friday',
    'before 5pm on Friday',
  ],
  rangeStrategy: 'replaced',
  rebaseWhen: 'conflicted',
  packageRules: [
    {
      groupName: 'envied',
      matchPackageNames: [
        'envied',
        'envied_generator',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: 'freezed',
      matchPackageNames: [
        'freezed',
        'freezed_annotation',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'dart_pub',
      automerge: true,
      platformAutomerge: true,
      matchManagers: [
        'pub',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
        'patch',
        'minor',
      ],
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      platformAutomerge: true,
    },
  ],
  enabledManagers: [
    'github-actions',
    'pub',
  ],
  customManagers: [
    {
      customType: 'regex',
      fileMatch: [
        '^.github/actions/setup-flutter-project/action.yml$',
      ],
      matchStrings: [
        '.*flutter-version: \'(?<currentValue>.*?)\'.*\n',
      ],
      depNameTemplate: 'flutter',
      lookupNameTemplate: 'flutter/flutter',
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+).*?$',
      extractVersionTemplate: '^(?<version>.*)$'
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    platformAutomerge: true,
    schedule: [
      'after 3pm and before 5pm on Friday',
    ],
  },
}
